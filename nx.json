{
	"$schema": "./node_modules/nx/schemas/nx-schema.json",
	"defaultProject": "react-kit-demo",
	"projects": {
		"ui": "react-kit",
		"docs": {
			"root": "apps/docs"
		}
	},
	"namedInputs": {
		"default": ["{projectRoot}/**/*", "sharedGlobals"],
		"production": [
			"default",
			"!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
			"!{projectRoot}/tsconfig.spec.json",
			"!{projectRoot}/.oxlintrc.json",
			"!{projectRoot}/oxlint.config.js",
			"!{projectRoot}/oxlint.config.mts"
		],
		"sharedGlobals": []
	},
	"plugins": [
		{
			"plugin": "@nx/vite/plugin",
			"options": {
				"buildTargetName": "build",
				"serveTargetName": "serve",
				"previewTargetName": "preview",
				"serveStaticTargetName": "serve-static"
			}
		},
		{
			"plugin": "@nx/oxlint",
			"options": {
				"targetName": "lint"
			}
		},
		{
			"plugin": "@nx/vitest",
			"options": {
				"testTargetName": "test"
			}
		}
	],
	"generators": {
		"@nx/react": {
			"application": {
				"babel": true,
				"style": "scss",
				"linter": "oxlint",
				"bundler": "vite"
			},
			"component": {
				"style": "scss"
			},
			"library": {
				"style": "scss",
				"linter": "oxlint",
				"unitTestRunner": "vitest"
			}
		}
	},
	"nxCloudId": "670ebadac0c313acbf9ee13c",
	"analytics": false
}
