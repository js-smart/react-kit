{
	"name": "@js-smart/react-kit",
	"version": "6.1.0",
	"private": false,
	"license": "MIT",
	"type": "module",
	"scripts": {
		"start": "pnpm --filter react-kit-demo start",
		"start:docs": "pnpm --filter docs start",
		"build": "pnpm --filter @js-smart/react-kit build",
		"build:demo": "pnpm --filter react-kit-demo build",
		"build:docs": "pnpm --filter docs build",
		"test": "pnpm --filter @js-smart/react-kit test",
		"lint": "oxlint .",
		"format": "oxfmt .",
		"prepare": "husky"
	},
	"lint-staged": {
		"*": "oxfmt --no-error-on-unmatched-pattern"
	},
	"dependencies": {
		"@emotion/react": "11.14.0",
		"@emotion/styled": "11.14.1",
		"@mui/icons-material": "^9.4.0",
		"@mui/material": "^9.4.0",
		"@mui/x-data-grid": "^8.29.3",
		"@tanstack/react-router": "^1.170.32",
		"date-fns": "^4.4.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8"
	},
	"devDependencies": {
		"@semantic-release/git": "^10.0.1",
		"@semantic-release/npm": "^13.1.5",
		"@testing-library/jest-dom": "^6.5.0",
		"@testing-library/react": "16.3.0",
		"@types/node": "22.15.14",
		"@types/react": "19.1.3",
		"@types/react-dom": "19.1.3",
		"@vitejs/plugin-react": "6.0.2",
		"@vitest/coverage-v8": "4.0.9",
		"@vitest/ui": "4.0.9",
		"husky": "^9.1.7",
		"jest-mock": "^29.7.0",
		"jsdom": "~26.1.0",
		"lint-staged": "^17.4.1",
		"oxfmt": "^0.66.0",
		"oxlint": "^1.81.0",
		"sass": "^1.103.1",
		"semantic-release": "^25.0.9",
		"typescript": "6.0.3",
		"vite": "8.0.16",
		"vite-plugin-dts": "^4.5.4",
		"vite-plugin-mkcert": "^1.17.12",
		"vitest": "4.0.9"
	},
	"release": {
		"branches": [
			"main"
		],
		"plugins": [
			"@semantic-release/commit-analyzer",
			"@semantic-release/release-notes-generator",
			[
				"@semantic-release/npm",
				{
					"pkgRoot": "dist/react-kit"
				}
			],
			"@semantic-release/git",
			"@semantic-release/github"
		]
	}
}
