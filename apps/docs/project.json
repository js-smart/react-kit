{
	"name": "docs",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"sourceRoot": "apps/docs",
	"projectType": "application",
	"tags": [],
	"targets": {
		"start": {
			"executor": "nx:run-commands",
			"options": {
				"command": "./node_modules/.bin/docusaurus start --port 3008",
				"cwd": "apps/docs"
			}
		},
		"build": {
			"executor": "nx:run-commands",
			"options": {
				"command": "./node_modules/.bin/docusaurus build",
				"cwd": "apps/docs"
			},
			"outputs": ["{projectRoot}/build"]
		},
		"serve": {
			"executor": "nx:run-commands",
			"options": {
				"command": "./node_modules/.bin/docusaurus serve --port 3008",
				"cwd": "apps/docs"
			}
		}
	}
}
