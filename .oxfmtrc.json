{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"printWidth": 140,
	"singleQuote": true,
	"trailingComma": "es5",
	"semi": true,
	"bracketSameLine": true,
	"useTabs": true,
	"endOfLine": "lf",
	"sortPackageJson": false,
	"ignorePatterns": ["/dist", "/coverage", "/.nx/cache", "/.nx/workspace-data", ".nx/self-healing"]
}
